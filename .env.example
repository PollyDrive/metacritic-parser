# База данных
# DATABASE_URL здесь — host-значение (poetry run на хосте). Внутри compose
# app/worker получают db:5432 через environment: в docker-compose.yml.
POSTGRES_DB=metacritic_game_tracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5440/metacritic_game_tracker_db

# LLM (OpenCode / OpenRouter) — для резюме отзывов и заключений по летсплеям
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# YouTube Data API — поиск летсплеев (Дополнительная часть 1)
YOUTUBE_API_KEY=

# Мониторинг (Дополнительная часть 2) — единственный оператор
MONITORING_USERNAME=admin
MONITORING_PASSWORD=changeme

# Приложение
APP_ENV=dev
LOGS_DIR=/app/logs

# Алертинг — Resend API, без SMTP (metacritic_game_tracker/infrastructure/alerting/email.py)
RESEND_API_KEY=
ALERT_EMAIL_TO=

# ВАЖНО: операционные настройки (частота прогонов, активные часы, размер пачки,
# задержка между запросами, размер выборки отзывов, бюджет YouTube, ретраи)
# здесь НЕ живут — они в таблице runtime_config и правятся на лету через
# /monitoring/config. Тут только секреты и инфраструктура.

# MCP серверы (используются Claude Code, не попадают в контейнеры)
METACRITIC_GAME_TRACKER_DB_URL=postgresql://postgres:changeme@localhost:5440/metacritic_game_tracker_db
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-...
