# База данных
POSTGRES_DB=metacritic_game_tracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5434/metacritic_game_tracker_db

# LLM (OpenCode / OpenRouter) — для резюме отзывов и заключений по летсплеям
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://api.opencode.ai/zen/v1

# YouTube Data API — поиск летсплеев (Дополнительная часть 1)
YOUTUBE_API_KEY=

# Мониторинг (Дополнительная часть 2) — единственный оператор
MONITORING_USERNAME=admin
MONITORING_PASSWORD=changeme

# Приложение
APP_ENV=dev
LOGS_DIR=/app/logs

# MCP серверы (используются Claude Code, не попадают в контейнеры)
METACRITIC_GAME_TRACKER_DB_URL=postgresql://postgres:changeme@localhost:5434/metacritic_game_tracker_db
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-...
